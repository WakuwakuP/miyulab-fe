{
  "channel": "static",
  "permissions": {
    "allow": ["Read(.cursor-input/**)", "Read(.github/cursor/prompts/**)"],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(.config/cursor)",
      "Read(.config/cursor/**)",
      "Read(**/.config/cursor)",
      "Read(**/.config/cursor/**)",
      "Read(.cursor)",
      "Read(.cursor/**)",
      "Read(**/.cursor)",
      "Read(**/.cursor/**)",
      "Read(.git)",
      "Read(.git/**)",
      "Read(**/.git)",
      "Read(**/.git/**)",
      "Read(/dev/**)",
      "Read(/etc/**)",
      "Read(/proc/**)",
      "Read(/sys/**)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Write(.config/cursor/**)",
      "Write(.config/cursor)",
      "Write(**/.config/cursor)",
      "Write(**/.config/cursor/**)",
      "Write(.cursor)",
      "Write(.cursor/**)",
      "Write(**/.cursor)",
      "Write(**/.cursor/**)",
      "Write(**)",
      "Shell(*)"
    ]
  }
}
