{
  "permissions": {
    "allow": ["Read(.cursor-input/**)", "Read(.github/cursor/prompts/**)"],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(.git/**)",
      "Read(/dev/**)",
      "Read(/etc/**)",
      "Read(/proc/**)",
      "Read(/sys/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Write(**)",
      "Shell(bash)",
      "Shell(cargo)",
      "Shell(corepack)",
      "Shell(curl)",
      "Shell(env)",
      "Shell(fish)",
      "Shell(gh)",
      "Shell(git)",
      "Shell(go)",
      "Shell(java)",
      "Shell(node)",
      "Shell(npm)",
      "Shell(npx)",
      "Shell(openssl)",
      "Shell(perl)",
      "Shell(php)",
      "Shell(pnpm)",
      "Shell(printenv)",
      "Shell(python)",
      "Shell(python3)",
      "Shell(ruby)",
      "Shell(rustc)",
      "Shell(sh)",
      "Shell(ssh)",
      "Shell(wget)",
      "Shell(yarn)",
      "Shell(zsh)"
    ]
  }
}
